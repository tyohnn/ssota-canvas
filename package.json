{
  "name": "ssota",
  "version": "0.8.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\" \"apps/*/src/**/*.{ts,tsx,js,jsx}\" \"packages/*/src/**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "turbo typecheck",
    "changelog": "git-cliff --verbose",
    "changelog:check": "git-cliff --verbose --check",
    "changelog:preview": "git-cliff --verbose --bump"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/node": "^22.10.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "git-cliff": "^2.4.0",
    "prettier": "^3.5.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "turbo": "^2.4.2",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "date-fns": "^4.1.0"
  }
}
