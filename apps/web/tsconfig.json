{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      // fallbacks to UI package when not found in app
      "@/components/*": [
        "../../packages/ui/src/components/*",
        "./src/components/*"
      ],
      "@/hooks/*": ["../../packages/ui/src/hooks/*", "./src/hooks/*"],
      "@/lib/*": ["../../packages/ui/src/lib/*", "./src/lib/*"],
      "@workspace/ui/components/*": ["../../packages/ui/src/components/*"],
      "@workspace/ui/hooks/*": ["../../packages/ui/src/hooks/*"],
      "@workspace/ui/lib/*": ["../../packages/ui/src/lib/*"],
      "@workspace/ui/styles/*": ["../../packages/ui/src/styles/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "jest.setup.js",
    "src/domains/canvas/components/editor/property-input"
, "src/domains/canvas/handlers/useReactFlowHandler.tsㅌ"  ],
  "exclude": ["node_modules"]
}
