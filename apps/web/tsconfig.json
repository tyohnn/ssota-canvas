{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      // fallbacks to UI package when not found in app
      "@/components/*": [
        "./src/components/*",
        "../../packages/ui/src/components/*"
      ],
      "@/hooks/*": ["./src/hooks/*", "../../packages/ui/src/hooks/*"],
      "@/lib/*": ["./src/lib/*", "../../packages/ui/src/lib/*"],
      "@workspace/ui/components/*": ["../../packages/ui/src/components/*"],
      "@workspace/ui/hooks/*": ["../../packages/ui/src/hooks/*"],
      "@workspace/ui/lib/*": ["../../packages/ui/src/lib/*"],
      "@workspace/ui/styles/*": ["../../packages/ui/src/styles/*"],
      "@workspace/editor-panel": ["../../packages/editor-panel/src/index.ts"],
      "@workspace/editor-panel/*": ["../../packages/editor-panel/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "jest.setup.js"
  ],
  "exclude": ["node_modules", "supabase"]
}
