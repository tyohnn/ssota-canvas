{
  "name": "web",
  "version": "0.9.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --testPathPattern=unit",
    "test:integration": "vitest --testPathPattern=integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "pnpm test && pnpm test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:migrate": "pnpm db:generate && pnpm db:migrate:copy",
    "db:migrate:copy": "npx tsx scripts/migrate-to-supabase.ts",
    "supabase:start": "npx supabase start",
    "supabase:dev": "pnpm exec supabase start && pnpm exec supabase functions serve --env-file supabase/.env.local",
    "supabase:stop": "npx supabase stop",
    "supabase:reset": "npx supabase db reset",
    "supabase:status": "npx supabase status",
    "supabase:studio": "open http://127.0.0.1:54323",
    "supabase:migration:down": "npx supabase migration down --local --last 1 2>&1",
    "supabase:migration:up": "npx supabase migration up --local"
  },
