# apps/web/.env.example

#################################################
# 🔧 Local Development Environment Variables
#################################################

# ------------------------------------------
# 🗄️ Database & Supabase (Local)
# ------------------------------------------
# Run 'supabase start' to get these values
# These are standard keys that work for all team members

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Database connection (local)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:6543/postgres

# ------------------------------------------
# 🤖 AI Services (Optional)
# ------------------------------------------
# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Google AI API Key
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-key-here

AI_GATEWAY_API_KEY=your-ai-gateway-key-here

HELICONE_API_KEY=your-helicone-key-here


# ------------------------------------------
# 📊 Other API Providers (Optional)
# ------------------------------------------
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=your-unsplash-key-here
YOUTUBE_API_KEY=your-youtube-api-key-here


# ------------------------------------------
# 📊 Analytics & Monitoring (Optional)
# ------------------------------------------
# Vercel Analytics (auto-configured in Vercel)
# VERCEL_ANALYTICS_ID=

# Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token-here

# Sentry (if using)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn-here
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here

# ------------------------------------------
# 🌍 Environment
# ------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# 📝 Notes for Team Members
# ------------------------------------------
# 1. Copy this file to .env.local
# 2. Run 'supabase start' to initialize local Supabase
# 3. Update Clerk keys with your own development keys
# 4. AI service keys are optional for local development
# 5. Never commit .env.local to git!