# Supabase Edge Functions (로컬) 전용 — process-summary-queue 등
# pnpm supabase:dev 는 supabase/.env.local 을 사용합니다.
# 복사: cp supabase/.env.example supabase/.env.local 후 값을 채우세요.
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY 는 supabase functions serve 가 로컬에서 자동 주입하므로 넣지 않아도 됩니다.

# 앱 URL (Edge Function이 POST /api/source/process-job 호출 시 사용)
# 로컬: Edge Function은 Docker 안에서 돌아가므로 호스트의 Next.js에 접근하려면 host.docker.internal 사용
NEXT_PUBLIC_APP_URL=http://host.docker.internal:3000
# 배포 시: https://your-app.vercel.app 등 실제 앱 URL로 설정

# 내부 API 인증 시크릿 (앱 .env.local 의 INTERNAL_API_SECRET 과 동일해야 함)
INTERNAL_API_SECRET=your-internal-api-secret-here

# (선택) Preview/Dev 배포에 Vercel Deployment Protection이 켜져 있을 때만 필요.
# Vercel: Project Settings → Deployment Protection → Protection Bypass for Automation 에서 시크릿 생성 후 동일 값을 여기/Supabase Secrets에 VERCEL_PROTECTION_BYPASS_SECRET 으로 설정.
VERCEL_PROTECTION_BYPASS_SECRET=your-vercel-protection-bypass-secret-here
