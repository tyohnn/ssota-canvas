    {
      "id": "node-slug-format-constraint",
      "type": "database-constraint",
      "position": { "x": 600, "y": 350 },
      "metadata": {
        "name": "Node Slug Format Constraint",
        "description": "Check constraint ensuring valid slug format",
        "type": "basic",
        "constraintName": "chk_nodes_slug_format",
        "constraintType": "check",
        "validationRule": "slug ~ '^[a-z0-9-]+$'",
        "enforcementLevel": "strict",
        "errorMessage": "Slug must contain only lowercase letters, numbers, and hyphens",
        "owner": "Backend Team"
      }
    },
    {
      "id": "node-name-length-constraint",
      "type": "database-constraint",
      "position": { "x": 800, "y": 350 },
      "metadata": {
        "name": "Node Name Length Constraint",
        "description": "Check constraint ensuring name length limits",
        "type": "basic",
        "constraintName": "chk_nodes_name_length",
        "constraintType": "check",
        "validationRule": "char_length(name) BETWEEN 1 AND 100",
        "enforcementLevel": "strict",
        "errorMessage": "Name must be between 1 and 100 characters",
        "owner": "Backend Team"
      }
    },
    {
      "id": "edge-type-constraint",
      "type": "database-constraint",
      "position": { "x": 200, "y": 650 },
      "metadata": {
        "name": "Edge Type Constraint",
        "description": "Check constraint ensuring valid edge types",
        "type": "basic",
        "constraintName": "chk_edges_type_valid",
        "constraintType": "check",
        "validationRule": "edge_type IN ('contains', 'next', 'input', 'output')",
        "enforcementLevel": "strict",
        "errorMessage": "Invalid edge type",
        "owner": "Backend Team"
      }
    },
    {
      "id": "edge-no-self-ref-constraint",
      "type": "database-constraint",
      "position": { "x": 400, "y": 650 },
      "metadata": {
        "name": "Edge No Self Reference Constraint",
        "description": "Check constraint preventing self-referencing edges",
        "type": "basic",
        "constraintName": "chk_edges_no_self_ref",
        "constraintType": "check",
        "validationRule": "source_node_id != target_node_id",
        "enforcementLevel": "strict",
        "errorMessage": "Edge cannot reference the same node",
        "owner": "Backend Team"
      }
    },
    {
      "id": "position-range-constraint",
      "type": "database-constraint",
      "position": { "x": 800, "y": 250 },
      "metadata": {
        "name": "Position Range Constraint",
        "description": "Check constraint ensuring valid position coordinates",
        "type": "basic",
        "constraintName": "chk_node_positions_range",
        "constraintType": "check",
        "validationRule": "x_position >= 0 AND y_position >= 0",
        "enforcementLevel": "strict",
        "errorMessage": "Position coordinates must be non-negative",
        "owner": "Frontend Team"
      }
    },
