      "id": "success-1",
      "type": "success",
      "position": { "x": 800, "y": 1200 },
      "metadata": {
        "name": "Workflow Saved Successfully",
        "description": "Workflow design is saved and ready for execution",
        "successMessage": "Workflow saved successfully! You can now execute it or continue editing.",
        "nextSteps": [
          "Execute workflow",
          "Share workflow",
          "Create workflow template",
          "Continue editing"
        ],
        "completionCriteria": "Workflow has valid structure with connected nodes and saved to system"
