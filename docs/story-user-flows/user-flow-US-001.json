      "type": "start",
      "position": { "x": 400, "y": 100 },
      "metadata": {
        "name": "User Enters Design Mode",
        "description": "User accesses the xbowl platform and enters design mode to create a new workflow",
        "userContext": "Non-technical user wanting to create AI agent workflow",
        "entryPoint": "Dashboard 'Create New Workflow' button or existing workflow edit"
      }
    },
    {
      "id": "page-1",
      "type": "page",
      "position": { "x": 400, "y": 200 },
      "metadata": {
        "name": "Workflow Designer Page",
        "description": "Visual workflow creation interface with dual canvas system, Editor Panel overlay, and 7 core node types",
        "pageType": "Form",
        "url": "/canvas",
        "components": [
          "SevenCoreNodeExplorer",
          "ReactFlowCanvas",
          "EditorPanelOverlay",
          "TopToolboxPanel",
          "ModeToggle",
          "NodeMetadataEditor"
        ],
        "accessibility": "WCAG 2.1 AA"
      }
    },
    {
      "id": "action-1",
      "type": "action",
      "position": { "x": 200, "y": 300 },
      "metadata": {
        "name": "Browse 7 Core Node Types",
        "description": "User explores the left panel to see available 7 core node types organized in folders (Agent, Task, Workflow, Artifact Template, Checklist, Data, Artifact Class)",
        "actionType": "Navigate",
        "target": "SevenCoreNodeExplorer",
        "inputData": {},
        "validation": []
      }
    },
    {
      "id": "decision-1",
      "type": "decision",
      "position": { "x": 200, "y": 400 },
      "metadata": {
        "name": "Core Node Type Selection",
        "description": "User decides which of the 7 core node types to add to the workflow",
        "condition": "What type of core node does user want to add?",
        "options": [
          "Agent node (AI agent with persona/role)",
          "Task node (executable task with I/O edges)",
          "Workflow node (orchestration with flow control)",
          "Artifact Template node (output structure definition)",
          "Checklist node (validation and guidance)",
          "Data node (reference information)",
          "Artifact Class node (abstract artifact representation)"
        ],
        "defaultPath": "Agent node"
      }
    },
    {
      "id": "action-2",
      "type": "action",
      "position": { "x": 400, "y": 500 },
      "metadata": {
        "name": "Click Plus and Select Widget",
        "description": "User clicks plus button in explorer to open widget selector (like Figma widget selection), then clicks desired widget to add to canvas",
        "actionType": "Click",
        "target": "WidgetSelector",
        "inputData": {
          "nodeType": "selected_widget_type",
          "widgetCategory": "selected_category"
        },
        "validation": ["Valid widget selection", "Widget available"]
      }
    },
    {
      "id": "system-response-1",
      "type": "system-response",
      "position": { "x": 400, "y": 600 },
      "metadata": {
        "name": "Node Appears on Canvas and Editor Opens",
        "description": "System creates visual node on canvas with default styling and immediately opens Editor Panel overlay for configuration",
        "responseType": "Success",
        "message": "Node added successfully - Editor Panel opened",
        "data": {
          "nodeId": "generated_node_id",
          "nodeType": "agent",
          "position": { "x": 100, "y": 100 },
          "editorPanelOpened": true
        },
        "processingTime": "Immediate"
      }
    },
    {
      "id": "action-3",
      "type": "action",
      "position": { "x": 600, "y": 500 },
      "metadata": {
        "name": "Open Editor Panel Overlay",
        "description": "User clicks node to open Editor Panel overlay for metadata editing",
        "actionType": "Click",
        "target": "Node on Canvas",
        "inputData": {
          "nodeId": "selected_node_id"
        },
        "validation": ["Node is selectable"]
      }
    },
    {
      "id": "page-2",
      "type": "page",
      "position": { "x": 600, "y": 600 },
      "metadata": {
        "name": "Editor Panel Overlay",
        "description": "Z-index overlay panel for context-aware node metadata editing with connected nodes visualization",
        "pageType": "Form",
        "url": "/canvas",
        "components": [
          "NodeMetadataEditor",
          "ConnectedNodesVisualization",
          "ContextAwareForms",
          "Alternative2DRendering"
        ],
        "accessibility": "WCAG 2.1 AA"
      }
    },
    {
      "id": "action-4",
      "type": "action",
      "position": { "x": 600, "y": 700 },
      "metadata": {
        "name": "Enter Node Configuration",
        "description": "User enters configuration details for the node (name, description, parameters)",
        "actionType": "Input",
        "target": "Properties Panel Form",
        "inputData": {
          "nodeName": "user_entered_name",
          "nodeDescription": "user_entered_description",
          "nodeParameters": "user_entered_parameters"
        },
        "validation": ["Required fields", "Name format", "Parameter validation"]
      }
    },
    {
      "id": "decision-2",
      "type": "decision",
      "position": { "x": 600, "y": 800 },
      "metadata": {
        "name": "Add More Nodes Decision",
        "description": "User decides whether to add more nodes to complete the workflow",
        "condition": "Does user want to add more nodes?",
        "options": ["Yes - Add another node", "No - Connect existing nodes"],
        "defaultPath": "Yes - Add another node"
      }
    },
    {
      "id": "action-5",
      "type": "action",
      "position": { "x": 800, "y": 900 },
      "metadata": {
        "name": "Connect Nodes",
        "description": "User creates visual connections between nodes by dragging from source to target",
        "actionType": "Drag",
        "target": "Node connection points",
        "inputData": {
          "sourceNodeId": "source_node_id",
          "targetNodeId": "target_node_id"
        },
        "validation": ["Valid connection", "No circular dependencies"]
      }
    },
    {
      "id": "system-response-2",
      "type": "system-response",
      "position": { "x": 800, "y": 1000 },
      "metadata": {
        "name": "Connection Created",
        "description": "System creates visual connection line between nodes",
        "responseType": "Success",
        "message": "Nodes connected successfully",
        "data": {
          "connectionId": "generated_connection_id",
          "sourceNode": "source_node_id",
          "targetNode": "target_node_id"
        },
        "processingTime": "Immediate"
      }
    },
    {
      "id": "action-6",
      "type": "action",
      "position": { "x": 800, "y": 1100 },
      "metadata": {
        "name": "Save Workflow",
        "description": "User saves the completed workflow design",
        "actionType": "Click",
        "target": "Save button in toolbar",
        "inputData": {
          "workflowName": "user_entered_name",
          "workflowDescription": "user_entered_description"
        },
        "validation": ["Workflow name required", "Valid workflow structure"]
