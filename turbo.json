{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "dist/**",
        "!.next/cache/**"
      ],
      "env": [
        "NODE_ENV",
        "POSTGRES_URL",
        "POSTGRES_PRISMA_URL",
        "POSTGRES_URL_NON_POOLING",
        "POSTGRES_PASSWORD",
        "POSTGRES_HOST",
        "POSTGRES_DATABASE",
        "POSTGRES_USER",
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_JWT_SECRET",
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "GOOGLE_GENERATIVE_AI_API_KEY",
        "AI_GATEWAY_API_KEY",
        "HELICONE_API_KEY",
        "XAI_API_KEY",
        "YOUTUBE_API_KEY",
        "UNSPLASH_ACCESS_KEY",
        "NEXT_PUBLIC_MIXPANEL_TOKEN",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_APP_URL",
        "ZENROWS_API_KEY",
        "INTERNAL_API_SECRET",
        "CI",
        "RUN_YOUTUBE_CAPTION_TESTS",
        "RUN_ZENROWS_CAPTION_TESTS"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "CI",
        "POSTGRES_URL",
        "POSTGRES_URL_NON_POOLING",
        "YOUTUBE_API_KEY",
        "ZENROWS_API_KEY",
        "RUN_YOUTUBE_CAPTION_TESTS",
        "RUN_ZENROWS_CAPTION_TESTS"
      ]
    }
  }
}